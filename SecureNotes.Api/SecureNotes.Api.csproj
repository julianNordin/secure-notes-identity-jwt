<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Swagger reads the XML doc comments off the controllers from Phase 05 onwards. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591 is "missing XML comment on a public member". Turning documentation
         generation on turns that warning on for every public type in the project,
         which is noise: the comments that matter are on the endpoints. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- FluentValidation.AspNetCore, which wired validation into the MVC pipeline
         automatically, is deprecated and no longer maintained. The supported route is
         the core package plus the DI extensions, with validation invoked explicitly -
         here by one action filter in Common/ValidationFilter.cs. -->
    <PackageReference Include="FluentValidation" Version="11.12.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- PrivateAssets=all: this is the design-time package that `dotnet ef migrations`
         needs. It is a build tool, not a runtime dependency, and shipping it to
         anything that references this project would be wrong.

         Held at 9.0.1, not the newest 9.0.x, to match the EF Core version that
         Npgsql 9.0.4 depends on. See the fix commit for why that matters. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1" PrivateAssets="all" />
  </ItemGroup>

</Project>
