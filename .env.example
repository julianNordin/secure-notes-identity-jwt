# Copy to .env and adjust if you want something other than the defaults.
# .env is gitignored; this file is tracked, so it must never hold a real value.

POSTGRES_USER=securenotes
POSTGRES_PASSWORD=securenotes
POSTGRES_DB=securenotes
POSTGRES_PORT=5432

# The JWT signing key is NOT read from this file in development. Set it with
#
#     dotnet user-secrets set "Jwt:SigningKey" "<at least 32 bytes of random data>"
#
# from inside SecureNotes.Api/. This entry exists to document the variable name
# for deployment, where the app reads Jwt__SigningKey from the environment.
# The app refuses to start if the key is missing, shorter than 32 bytes, or
# still equal to the placeholder below.
Jwt__SigningKey=replace-me-with-at-least-32-bytes-of-random-data
