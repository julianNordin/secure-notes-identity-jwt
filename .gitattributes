# Normalise every text file to LF in the repository. Without this, files authored on
# Windows land as CRLF, and a Linux CI runner then reports the whole tree as modified.
* text=auto eol=lf

# These are read by Windows tooling that still expects CRLF.
*.sln  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Never let git touch these.
*.png  binary
*.jpg  binary
*.ico  binary
*.gif  binary
*.pdf  binary
